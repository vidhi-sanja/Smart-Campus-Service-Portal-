Create.cshtml

@model SmartCampusPortal.Models.ServiceRequest

<h2>Create Campus Service Request</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <p>Student Name</p>
    @Html.TextBoxFor(m => m.StudentName)
    @Html.ValidationMessageFor(m => m.StudentName)

    <p>Department</p>
    @Html.TextBoxFor(m => m.Department)
    @Html.ValidationMessageFor(m => m.Department)

    <p>Service Type</p>
    @Html.DropDownListFor(m => m.ServiceType,
        new SelectList(new[]
        {
            "IT Support",
            "Library",
            "Maintenance",
            "Transport"
        }))

    @Html.ValidationMessageFor(m => m.ServiceType)

    <p>Description</p>
    @Html.TextAreaFor(m => m.Description)
    @Html.ValidationMessageFor(m => m.Description)

    <p>Priority</p>
    @Html.DropDownListFor(m => m.Priority,
        new SelectList(new[]
        {
            "Low",
            "Medium",
            "High"
        }))

    <br />
    <br />

    <input type="submit" value="Submit Request" />
}

<p>
    @Html.ActionLink("Back to List", "Index")
</p>

Index.cshtml

@model IEnumerable<SmartCampusPortal.Models.ServiceRequest>

<h2>Smart Campus Service Requests</h2>

<p>
    @Html.ActionLink("Create New Request", "Create")
</p>

<table border="1">
    <tr>
        <th>Request ID</th>
        <th>Student Name</th>
        <th>Department</th>
        <th>Service Type</th>
        <th>Description</th>
        <th>Priority</th>
        <th>Status</th>
        <th>Date</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.RequestId</td>
            <td>@item.StudentName</td>
            <td>@item.Department</td>
            <td>@item.ServiceType</td>
            <td>@item.Description</td>
            <td>@item.Priority</td>
            <td>@item.Status</td>
            <td>@item.RequestDate</td>

            <td>
                @Html.ActionLink(
                    "Update Status",
                    "UpdateStatus",
                    new { id = item.RequestId })
            </td>
        </tr>
    }
</table>

